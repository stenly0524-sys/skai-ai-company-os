# Copy to .env for a secure hosting platform; NEVER commit real secrets.
PORT=8787
DATABASE_URL=postgresql://user:password@localhost:5432/skai
# Generate 32+ random characters. Do NOT expose to the browser in production.
SKAI_ADMIN_TOKEN=replace-with-strong-random-secret
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
# Comma-separated HTTPS origins for authorized browser access; blank means none.
# For same-origin production deployment, leave CORS origins empty unless explicitly required.
ALLOWED_ORIGINS=
# Set false only on a local trusted PostgreSQL instance; default true.
DATABASE_SSL=true

# Maximum AI API requests started per Taiwan calendar day. Calls may spend different amounts.
SKAI_DAILY_AI_CALL_LIMIT=20

# Single-CEO staging password (minimum 16 chars, never commit the actual password).
SKAI_CEO_PASSWORD=replace-with-long-random-CEO-password
# Set to production when HTTPS is active; secure cookie required.
NODE_ENV=development
# Required only for HTTPS production staging: set the exact deployed site origin.
# PUBLIC_ORIGIN=https://your-private-staging-domain.example
# Run npm run preflight on the private staging host before starting the service.
